{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OH-MY-GANG!",
  "mainBinaryName": "lolgang",
  "version": "0.1.1",
  "identifier": "com.lijia.lolgang",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "OH-MY-GANG!",
        "width": 650,
        "height": 1118,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-component-update --disable-background-networking"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob: emote: http://emote.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost emote: http://emote.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNDFDODg3RDM5N0U2QzcKUldUSDVwZlRoOGhCR3Z3T3lLSExGdEdGQjl6cWNnN3VkSnl6dlJGNGcyUTRUck9OVE9oMmM2c3IK",
      "endpoints": [
        "https://github.com/a497527764/ohmygang/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "lijianqiao",
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "常驻桌面的英雄联盟开黑小工具：屏幕上发信号、放表情、按住说话，队友同步看到",
    "copyright": "Copyright © 2026 lijianqiao",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
