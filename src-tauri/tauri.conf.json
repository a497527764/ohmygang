{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lolGang",
  "mainBinaryName": "lolgang",
  "version": "2.0.1",
  "identifier": "com.lijia.lolgang",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "钢一下",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NTNDNDlFRTY4QjEzQjAKUldTd0U0dm1uc1JUMTBLc0RMV2xxTmFsckJOenc2U0VXNG00V0RORmFqWWpWODV5cDVkL0xsNysK",
      "endpoints": [
        "https://github.com/lijianqiao/lolGang/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "lijianqiao",
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "lolGang（钢一下）：桌面上的英雄联盟信号、表情、组队和对线小玩具",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
